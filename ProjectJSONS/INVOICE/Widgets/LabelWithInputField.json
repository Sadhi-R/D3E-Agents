[
    {
        "name": "LabelWithInputField",
        "category": "UserDefined",
        "properties": [
            {
                "name": "Label",
                "type": "String"
            },
            {
                "name": "PlaceHolder",
                "type": "String"
            },
            {
                "name": "Is Required",
                "type": "Boolean",
                "defaultValue": "`false`"
            },
            {
                "name": "Value",
                "type": "String"
            },
            {
                "name": "Errors",
                "type": "String",
                "collection": true
            },
            {
                "name": "ObscureText",
                "type": "Boolean",
                "defaultValue": "`false`",
                "stylable": true
            },
            {
                "name": "FocusNode",
                "type": "FocusNode",
                "internal": true
            },
            {
                "name": "Active",
                "type": "Boolean",
                "internal": true
            },
            {
                "name": "disable",
                "type": "Boolean",
                "defaultValue": "`false`"
            },
            {
                "name": "Field Color",
                "type": "Color",
                "stylable": true
            },
            {
                "name": "MaxLines",
                "type": "Integer",
                "defaultValue": "`1`",
                "stylable": true
            },
            {
                "name": "Corner Radius",
                "type": "Double",
                "defaultValue": "`4.0`",
                "stylable": true
            },
            {
                "name": "keyboardType",
                "type": "TextInputType",
                "stylable": true
            },
            {
                "name": "Dense",
                "type": "Boolean",
                "defaultValue": "`false`",
                "stylable": true
            }
        ],
        "build": {
            "component": "Column",
            "styles": [],
            "data": {
                "margin": "'8 4 0 4'",
                "crossAxisAlignment": "'start'"
            },
            "children": [
                {
                    "type": "CIf",
                    "name": "id",
                    "condition": "`this.label != null && this.label.isNotEmpty`",
                    "then": {
                        "type": "Row",
                        "name": "id",
                        "data": {
                            "margin": "'0 0 5 0'"
                        },
                        "children": [
                            {
                                "type": "TextView",
                                "name": "Nameview",
                                "data": {
                                    "data": "`this.label`",
                                    "fontSize": "'14'",
                                    "fontWeight": "'w500'",
                                    "color": "'ff000000'"
                                }
                            },
                            {
                                "type": "CIf",
                                "name": "id",
                                "condition": "`isRequired`",
                                "then": {
                                    "type": "TextView",
                                    "name": "id",
                                    "data": {
                                        "data": "'*'",
                                        "color": "'FFC20F2F'",
                                        "fontSize": "'14'",
                                        "fontWeight": "'w500'"
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "InputField",
                    "name": "Field",
                    "data": {
                        "value": "`value`",
                        "height": "'40'",
                        "backgroundColor": "'ffffffff'",
                        "placeHolderColor": "'ff191919'",
                        "inActiveColor": "'ffe8e1e1'",
                        "activeColor": "'ff299d91'",
                        "padding": "'0 10'",
                        "focusNode": "`focusNode`",
                        "obscureText": "`obscureText`",
                        "placeHolder": "`this.placeHolder`",
                        "disable": "`disable`",
                        "maxLines": "`maxLines`",
                        "dense": "`dense`",
                        "keyboardType": "`keyboardType`",
                        "textStyle": {
                            "fontSize": "'15'",
                            "fontWeight": "'w500'",
                            "color": "'ff191919'"
                        },
                        "cornerRadius": "`cornerRadius`"
                    },
                    "conditionals": [
                        {
                            "condition": "`this.disable`",
                            "values": {
                                "backgroundColor": "'FFB4B4B4'"
                            }
                        },
                        {
                            "condition": "`this.fieldColor == null`",
                            "values": {
                                "backgroundColor": "'FFFFFFFF'"
                            }
                        },
                        {
                            "condition": "`errors.isNotEmpty`",
                            "values": {
                                "inActiveColor": "'FFC20F2F'"
                            }
                        }
                    ]
                },
                {
                    "type": "CIf",
                    "name": "id",
                    "condition": "`this.errors.isNotEmpty`",
                    "then": {
                        "type": "Column",
                        "name": "id",
                        "data": {
                            "crossAxisAlignment": "'start'"
                        },
                        "children": [
                            {
                                "type": "String",
                                "name": "Item",
                                "var": "'item'",
                                "items": "`this.errors`",
                                "item": {
                                    "type": "TextView",
                                    "name": "id",
                                    "data": {
                                        "data": "`item`",
                                        "margin": "'5 0 0'",
                                        "color": "'FFC20F2F'",
                                        "textAlign": "'start'"
                                    }
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "eventHandlers": [
            {
                "name": "OnInit",
                "block": "```\n                focusNode = FocusNode();\n                focusNode.addListener(onChangeFocus);\n            ```"
            },
            {
                "name": "OnChangeFocus",
                "block": "```\n                active = focusNode.hasFocus;\n                if(active && onTap != null){\n                    this.onTap();\n                }\n            ```"
            },
            {
                "name": "OnChangeText",
                "type": "OnEvent",
                "on": "field",
                "event": "onChanged",
                "block": "```\n                if(onChanged != null){\n                    onChanged(text);\n                }\n            ```"
            },
            {
                "name": "onTapHandker",
                "type": "OnEvent",
                "on": "field",
                "event": "onTap",
                "block": "```\n                this.errors.clear();\n                if(onTap != null){\n                    onTap();\n                }\n            ```"
            },
            {
                "name": "OnSubmiitedTextHandler",
                "type": "OnEvent",
                "on": "field",
                "event": "onSubmitted",
                "block": "```\n                if(onSubmitted != null){\n                    onSubmitted(text);\n                }\n            ```"
            }
        ],
        "events": [
            {
                "name": "OnChanged",
                "params": [
                    {
                        "name": "Value",
                        "type": "String"
                    }
                ]
            },
            {
                "name": "OnTap"
            },
            {
                "name": "OnSubmitted",
                "params": [
                    {
                        "name": "Value",
                        "type": "String"
                    }
                ]
            }
        ],
        "twoWayBinding": true
    }
]
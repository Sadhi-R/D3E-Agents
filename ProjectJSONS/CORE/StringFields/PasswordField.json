[
    {
        "name": "PasswordField",
        "category": "UserDefined",
        "properties": [
            {
                "name": "Name",
                "type": "String"
            },
            {
                "name": "PlaceHolder",
                "type": "String"
            },
            {
                "name": "Is Required",
                "type": "Boolean",
                "defaultValue": "`false`"
            },
            {
                "name": "Value",
                "type": "String"
            },
            {
                "name": "Errors",
                "type": "String",
                "collection": true
            },
            {
                "name": "FocusNode",
                "type": "FocusNode",
                "internal": true
            },
            {
                "name": "disable",
                "type": "Boolean",
                "defaultValue": "`false`"
            },
            {
                "name": "MaxLines",
                "type": "Integer",
                "stylable": true,
                "defaultValue": "`1`"
            },
            {
                "name": "VisiblePassword",
                "type": "Boolean",
                "internal": true
            },
            {
                "name": "HackValue",
                "type": "Boolean",
                "internal": true
            }
        ],
        "build": {
            "component": "Column",
            "data": {
                "crossAxisAlignment": "start"
            },
            "children": [
                {
                    "type": "Wrap",
                    "name": "id",
                    "children": [
                        {
                            "type": "CIf",
                            "name": "id",
                            "condition": "`this.name != null && this.name.isNotEmpty`",
                            "then": {
                                "type": "TextView",
                                "name": "Nameview",
                                "data": {
                                    "data": "`this.name`"
                                }
                            }
                        },
                        {
                            "type": "CIf",
                            "name": "id",
                            "condition": "`isRequired`",
                            "then": {
                                "type": "TextView",
                                "name": "id",
                                "data": {
                                    "data": "'*'"
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "Row",
                    "name": "Row3",
                    "children": [
                        {
                            "type": "InputField",
                            "name": "Field",
                            "data": {
                                "value": "`value`",
                                "focusNode": "`focusNode`",
                                "activeColor": "'00ff0000'",
                                "inActiveColor": "'00ff0000'",
                                "obscureText": "'true'",
                                "placeHolder": "`this.placeHolder`",
                                "disable": "`disable`",
                                "expand": "'true'"
                            },
                            "conditionals": [
                                {
                                    "condition": "`this.visiblePassword`",
                                    "values": {
                                        "obscureText": "'false'"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "Button",
                            "name": "VisibilityButton",
                            "child": {
                                "type": "IconView",
                                "name": "IconView4",
                                "data": {
                                    "icon": "'MaterialIcons.visibility_off'",
                                    "size": "'20'"
                                },
                                "conditionals": [
                                    {
                                        "condition": "`visiblePassword`",
                                        "values": {
                                            "icon": "'MaterialIcons.visibility.59636'"
                                        }
                                    }
                                ]
                            }
                        }
                    ],
                    "states": [
                        {
                            "name": "Active",
                            "type": "Boolean",
                            "defaultValue": "`hackValue`"
                        }
                    ]
                },
                {
                    "type": "CIf",
                    "name": "id",
                    "condition": "`this.errors.isNotEmpty`",
                    "then": {
                        "type": "Column",
                        "name": "id",
                        "data": {
                            "crossAxisAlignment": "start"
                        },
                        "children": [
                            {
                                "type": "String",
                                "name": "Item",
                                "var": "item",
                                "items": "`this.errors`",
                                "item": {
                                    "type": "TextView",
                                    "name": "id",
                                    "data": {
                                        "data": "`item`"
                                    }
                                }
                            }
                        ]
                    }
                }
            ]
        },
        "eventHandlers": [
            {
                "name": "OnInit",
                "block": "```focusNode = FocusNode();\nfocusNode.addListener(onChangeFocus);```"
            },
            {
                "name": "OnChangeFocus",
                "block": "```row3.active = focusNode.hasFocus;```"
            },
            {
                "name": "OnChangeText",
                "type": "OnEvent",
                "on": "field",
                "event": "onChanged",
                "block": "```if(onChanged != null){\n    onChanged(text);\n}```"
            },
            {
                "name": "onPressedVisibilityButtonHandler",
                "type": "OnEvent",
                "on": "visibilityButton",
                "event": "onPressed",
                "block": "```visiblePassword = !visiblePassword;```"
            }
        ],
        "events": [
            {
                "name": "OnChanged",
                "params": [
                    {
                        "name": "Value",
                        "type": "String"
                    }
                ]
            }
        ],
        "twoWayBinding": true
    }
]
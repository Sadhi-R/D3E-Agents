StyleTheme {
    name 'NeonCraft'
    description 'Futuristic, neon-colored theme with glowing UI accents'
    color '00000000' // Default background color
    font 'Roboto'
    fontSize 14.0
    colors [
        {
            color '@c1'
            hexCode 'FF00FF00' // Neon Green
            description 'Neon Green'
        }
        {
            color '@c2'
            hexCode 'FFFF00FF' // Neon Magenta
            description 'Neon Magenta'
        }
        {
            color '@c3'
            hexCode 'FF00FFFF' // Neon Cyan
            description 'Neon Cyan'
        }
        {
            color '@c4'
            hexCode 'FFFF0000' // Neon Red
            description 'Neon Red'
        }
        {
            color '@c5'
            hexCode 'FFFFFF00' // Neon Yellow
            description 'Neon Yellow'
        }
        {
            color '@c6'
            hexCode 'FFFFA500' // Neon Orange
            description 'Neon Orange'
        }
        {
            color '@c7'
            hexCode 'FF3B5998' // Neon Blue
            description 'Neon Blue'
        }
        {
            color '@c8'
            hexCode 'FF4B0082' // Neon Indigo
            description 'Neon Indigo'
        }
        {
            color '@c9'
            hexCode 'FF933AB6' // Neon Lavender
            description 'Neon Lavender'
        }
        {
            color '@c10'
            hexCode 'FF6A5ACD' // Neon Slate Blue
            description 'Neon Slate Blue'
        }
        {
            color '@c11'
            hexCode 'FF7FFF00' // Neon Chartreuse
            description 'Neon Chartreuse'
        }
        {
            color '@c12'
            hexCode 'FFD2691E' // Neon Chocolate
            description 'Neon Chocolate'
        }
        {
            color '@c13'

            description 'Neon Dark Magenta'
        }
        {
            color '@c14'
            hexCode 'FFB22222' // Neon Firebrick
            description 'Neon Firebrick'
        }
        {
            color '@c15'
            hexCode 'FFFFD700' // Neon Gold
            description 'Neon Gold'
        }
        {
            color '@c16'
            hexCode 'FFADFF2F' // Neon Green Yellow
            description 'Neon Green Yellow'
        }
        {
            color '@c17'
            hexCode 'FF8A2BE2' // Neon Blue Violet
            description 'Neon Blue Violet'

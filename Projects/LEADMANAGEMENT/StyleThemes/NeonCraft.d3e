            color '@c20'
            hexCode 'FFB0E0E6' // Neon Powder Blue
            description 'Neon Powder Blue'
        }
    ]
    textColor '@c1' // Default text color
    tooltipBackgroundColor '@c2' // Default tooltip background color
    tooltipTextColor '@c5' // Default tooltip text color
}
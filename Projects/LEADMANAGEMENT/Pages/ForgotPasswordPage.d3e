Page {
    package 'lead.management'
    name 'Forgot Password Page'
    category 'UserDefined'
    properties [
        {
            name 'Email'
            type String
            internal true
        }
        {
            name 'EndUser'
            type User
            internal true
        }
        {
            name 'ShowOtpPage'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'OtpErrorMessages'
            collection true
            type String
            internal true
        }
        {
            name 'ShowOtpError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowOtpValidationError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'UserEnteredOTP'
            type String
            internal true
        }
        {
            name 'Token'
            type String
            internal true
        }
        {
            name 'HitRequest'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'EmailInfo'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'userEmailError'
            collection true
            type String
            internal true
        }
    ]
    build Column {
        name 'Column'
        styles [
            ScreenBgColor
        ]
        data {
            mainAxisAlignment 'center'
            crossAxisAlignment 'center'
        }
        children [
            CIf {
                name 'If2'
                condition `!showOtpPage`
                then Column {
                    name 'Column'
                        styles [
                        BaseViewStyle
                    ]
                    data {
                        mainAxisAlignment 'start'
                        crossAxisAlignment 'start'
                        width '550'
                        height '450'
                        mainAxisSize 'min'
                        padding '30'
                    }
                    children [
                        TextView {
                            name 'TextView'
                            styles [
                                HeadlineTwo
                            ]
                            data {
                                data 'Lead Management'
                                margin '0 5 20 5'
                                color '@c1'
                            }
                        }
                        TextView {
                            name 'TextView2'
                            styles [
                                HeadlineThree
                            ]
                            data {
                                data 'Forgot Password'
                                margin '0 5 10 5'
                            }
                        }
                        Row {
                            children [
                                TextView {
                                    name 'TextView'
                                    data {
                                        data 'Enter your email address to get the \npassword reset link.'
                                        softWrap 'true'
                                        textAlign 'center'
                                        margin '0 5'
                                    }
                                }
                            ]   
                        }
                        LabelField {
                            name 'Email Field'
                            data {
                                name 'Email Address'
                                placeHolder 'Enter Email Address'
                                margin '20 0 0'
                                value `email`
                                isRequired 'true'
                                errors `userEmailError`
                            }
                            twoWayBinding true
                        }
                        CIf {
                            name 'ErrroMsg2'
                            condition `this.emailInfo`
                            then TextView {
                                name 'ErrorTextView'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'Please enter an email address'
                                    fontSize '14'
                                    margin '5 0 0'
                                }
                            }
                        }
                        CIf {
                            name 'ErrroMsg3'
                            condition `this.showError`
                            then TextView {
                                name 'ErrorTextView2'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'You have entered Invalid Email id'
                                }
                            }
                        }
                        CIf {
                            name 'OtpErrorResponce2'
                            condition `showOtpError`
                            then Column {
                                name 'ErrorMessageList2'
                                data {
                                    crossAxisAlignment 'start'
                                }
                                children [
                                    CFor {
                                        name 'Error2'
                                        var 'error'
                                        items `otpErrorMessages`
                                        type String
                                        item TextView {
                                            name 'id3'
                                            styles [
                                                ErrorLabel
                                            ]
                                            data {
                                                data `error`
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                        Row {
                            name 'id5'
                            data {
                                mainAxisAlignment 'center'
                                crossAxisAlignment 'start'
                                margin '20 5'
                            }
                            children [
                                CIf {
                                    name 'Buttons2'
                                    condition `!hitRequest`
                                    then Button {
                                        name 'Enable2'
                                        styles [
                                            Primary
                                        ]
                                        data {
                                            expand 'true'
                                        }
                                        child TextView {
                                            name 'id6'
                                            data {
                                                data 'Resend Password'
                                            }
                                        }
                                    }
                                    else Button {
                                        name 'Disable2'
                                        styles [
                                            Primary
                                        ]
                                        data {
                                            expand 'true'
                                        }
                                        child TextView {
                                            name 'id7'
                                            data {
                                                data 'Resend Password'
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                        Row {
                            name 'Row'
                            data {
                                mainAxisAlignment 'center'
                            }
                            children [
                                TextView {
                                    name 'TextView4'
                                    data {
                                        data 'Back to?'
                                    }
                                }
                                Button {
                                    name 'SignInButton'
                                    styles [
                                        LinkButton
                                    ]
                                    data {
                                        margin '0 0 0 5'
                                    }
                                    child TextView {
                                        name 'TextView5'
                                        data {
                                            data 'Login'
                                            color '@c1'
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
                else Column {
                    name 'In3'
                    styles [
                        BaseViewStyle
                    ]
                    data {
                        mainAxisAlignment 'center'
                        crossAxisAlignment 'start'
                        width '550'
                        height '450'
                        mainAxisSize 'min'
                        padding '30'
                    }
                    children [
                        Column {
                            name 'Form Column3'
                            data {
                                mainAxisAlignment 'center'
                                crossAxisAlignment 'center'
                            }
                            children [
                                TextView {
                                    name 'Id8'
                                    data {
                                        data `'We have sent an email to ' + this.email + ' with a One-Time code. Please provide the code below to complete the process.'`
                                        width '426'
                                        textAlign 'center'
                                        fontSize '14'
                                    }
                                }
                                Container {
                                    name 'id8'
                                    data {
                                        height '8'
                                    }
                                }
                                LabelField {
                                    name 'SetOtp2'
                                    data {
                                        name 'Enter One Time Code'
                                        placeHolder 'Enter The Code'
                                    }
                                }
                                CIf {
                                    name 'ErrorMessage2'
                                    condition `showOtpValidationError`
                                    then TextView {
                                        name 'ErrorLabel2'
                                        styles [
                                            ErrorLabel
                                        ]
                                        data {
                                            data 'Please enter valid otp !'
                                            textAlign 'center'
                                            fontSize '14'
                                            margin '5 0 0'
                                        }
                                    }
                                }
                                Row {
                                    name 'id9'
                                    data {
                                        mainAxisAlignment 'center'
                                        crossAxisAlignment 'start'
                                        margin '20 0 0 0'
                                    }
                                    children [
                                        Button {
                                            name 'ROTP2'
                                            styles [
                                                Secondary
                                            ]
                                            data {
                                                margin '0 10 0 0'
                                            }
                                            child TextView {
                                                name 'id10'
                                                data {
                                                    data 'Resend Code'
                                                }
                                            }
                                        }
                                        Button {
                                            name 'VerifyOtp2'
                                            styles [
                                                Primary
                                            ]
                                            child TextView {
                                                name 'id11'
                                                data {
                                                    data 'Verify Code'
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    }
    eventHandlers [
        {
            name 'SetStateEmail'
            type OnEvent
            on emailField
            event onChanged
            block ```
                this.email = value;
            ```
        }
        {
            name 'SetStateEmailError'
            type OnEvent
            on emailField
            event onTap
            block ```
                this.emailInfo = false;
                this.showError = false;
            ```
        }
        {
            name 'SetOTPCode'
            type OnEvent
            on setOtp2
            event onChanged
            block ```
                this.userEnteredOTP = value;
            ```
        }
        {
            name 'SetOTPCodeError'
            type OnEvent
            on setOtp2
            event onTap
            block ```
                this.showOtpValidationError = false;
            ```
        }
        {
            name 'ForgotPassword'
            type OnEvent
            on enable2
            event onPressed
            block ```
                doForgotPassword();
            ```
        }
        {
            name 'doForgotPassword'
            block ```
                this.hitRequest = true;
                this.showOtpError = false;
                this.showError = false;
                if(this.email == '') {
                    this.emailInfo = true;
                }else {
                    OneTimePassword otp = OneTimePassword(
                        input: this.email.toLowerCase(),
                        inputType: 'email',
                        userType: 'User',
                    );
                    Result<OneTimePassword> result = otp.save().await;
                    if (result.status == Success) {
                        this.token = otp.token;
                        this.showOtpPage = true;
                    }  else {
                        this.otpErrorMessages = result.errors;
                        this.hitRequest = false;
                        this.showOtpError = true;
                    }
                }
            ```
        }
        {
            name 'VerifyOTP'
            type OnEvent
            on verifyOtp2
            event onPressed
            block ```
                this.showOtpValidationError = false;
                LoginResult result = Query.loginWithOTP(
                    token: this.token,
                    code: this.userEnteredOTP
                ).await;
                if (result.success) {
                    endUser = result.userObject as User;
                    endUser.email = this.email;
                    navigator.pushChangePassWordPage(user: this.endUser);
                }
                else {
                    this.showOtpValidationError = true;
                }
            ```
        }
        {
            name 'ResendOTP'
            type OnEvent
            on rOTP2
            event onPressed
            block ```
                doForgotPassword();
            ```
        }
        {
            name 'onPressedSignInButton'
            type OnEvent
            on signInButton
            event onPressed
            block ```
                navigator.pushLoginPage();
            ```
        }
    ]
}
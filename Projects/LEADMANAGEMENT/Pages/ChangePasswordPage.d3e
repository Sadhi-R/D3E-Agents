Page {
    name 'ChangePassWordPage'
    properties [
        {
            name 'User'
            type User
            required true
        }
        {
            name 'NewPassword'
            type String
            internal true
        }
        {
            name 'ConfirmPassword'
            type String
            internal true
        }
        {
            name 'IsUpperCaseMissing'
            type Boolean
            computed true
            computation `!RegExp('.*[A-Z].*').hasMatch(newPassword)`
            internal true
        }
        {
            name 'IsLowerCaseMissing'
            type Boolean
            computed true
            computation `!RegExp('.*[a-z].*').hasMatch(newPassword)`
            internal true
        }
        {
            name 'IsContainsSpace'
            type Boolean
            computed true
            computation `(this.newPassword.contains(' '))`
            internal true
        }
        {
            name 'IsSpecialCharacterMissing'
            type Boolean
            computed true
            computation `!RegExp('.*[!@#$%&*].*').hasMatch(newPassword)`
            internal true
        }
        {
            name 'IsNumberMissing'
            type Boolean
            computed true
            computation `!RegExp('.*[0-9].*').hasMatch(newPassword)`
            internal true
        }
        {
            name 'IsNotMatchedPassword'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'IsNotMinimumLengthPwd'
            type Boolean
            computed true
            computation `!(this.newPassword.length >= 8)`
            internal true
        }
        {
            name 'ErrorMessages'
            collection true
            type String
            internal true
        }
        {
            name 'ShowErrors'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowSuccess'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowValidationError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowPasswordError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowConfirmPasswordError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'ShowNewPasswordError'
            type Boolean
            defaultValue `false`
            internal true
        }
        {
            name 'client'
            type TwilioClient
            internal true
        }
        {
            name 'Data'
            type CallData
            internal true
        }
    ]
    build Center {
        name 'Center'
        child  Column {
            name 'id'
            data {
                crossAxisAlignment 'center'
                mainAxisAlignment 'center'
                constraints {
                    maxWidth '600'
                    minWidth '500'
                }
                padding '20'
                decoration {
                    borderRadius '10'
                }
            }
            children [
                Column {
                    name 'Column'
                    styles [
                        BaseViewStyle
                    ]
                    data {
                        mainAxisAlignment 'center'
                        crossAxisAlignment 'start'
                        mainAxisSize 'min'
                        padding '20'
                    }
                    children [
                        TextView {
                            name 'PasswordLabel'
                            styles [
                                HeadlineThree
                            ]
                            data {
                                data 'Change Password'
                            }
                        }
                        LabelWithInputField {
                            name 'NewPasswordFieldWithLabel'
                            data {
                                name 'New Password'
                                value `newPassword`
                                placeHolder 'Enter New Password'
                                obscureText 'true'
                            }
                            twoWayBinding true
                        }
                        Column {
                            name 'PasswordRulesAll'
                            data {
                                crossAxisAlignment 'start'
                                width '430'
                                padding '0'
                                margin '10 0 0'
                            }
                            children [
                                TextView {
                                    name 'PasswordRules'
                                    styles [
                                        HeadlineFive
                                    ]
                                    data {
                                        data 'Password Rules:'
                                        margin '0 0 5'
                                    }
                                }
                                Row {
                                    name 'id'
                                    data {
                                        crossAxisAlignment 'center'
                                    }
                                    children [
                                        CIf {
                                            name 'id'
                                            condition `!isNotMinimumLengthPwd`
                                            then IconView {
                                                name 'Icon'
                                                data {
                                                    icon 'MaterialIcons.done'
                                                    size '15'
                                                    color '@c1'
                                                    padding '0 5 0 0'
                                                }
                                            }
                                        }
                                        TextView {
                                            name 'PasswordRules1'
                                            data {
                                                data 'Password must be atleast 8 characters long.'
                                            }
                                        }
                                    ]
                                }
                                Row {
                                    name 'id'
                                    data {
                                        crossAxisAlignment 'center'
                                    }
                                    children [
                                        CIf {
                                            name 'id'
                                            condition `!isUpperCaseMissing && !isLowerCaseMissing`
                                            then IconView {
                                                name 'Icon'
                                                data {
                                                    icon 'MaterialIcons.done'
                                                    size '15'
                                                    color '@c1'
                                                    padding '0 5 0 0'
                                                }
                                            }
                                        }
                                        TextView {
                                            name 'PasswordRules2'
                                            data {
                                                data 'Password must include 1 Uppercase and 1 Lowercase letter.'
                                            }
                                        }
                                    ]
                                }
                                Row {
                                    name 'id'
                                    data {
                                        crossAxisAlignment 'center'
                                    }
                                    children [
                                        CIf {
                                            name 'id'
                                            condition `!isNumberMissing`
                                            then IconView {
                                                name 'Icon'
                                                data {
                                                    icon 'MaterialIcons.done'
                                                    size '15'
                                                    color '@c1'
                                                    padding '0 5 0 0'
                                                }
                                            }
                                        }
                                        TextView {
                                            name 'PasswordRules3'
                                            data {
                                                data 'Password must contain 1 numeric character.'
                                            }
                                        }
                                    ]
                                }
                                Row {
                                    name 'id'
                                    data {
                                        crossAxisAlignment 'center'
                                    }
                                    children [
                                        CIf {
                                            name 'id'
                                            condition `!isSpecialCharacterMissing`
                                            then IconView {
                                                name 'Icon'
                                                data {
                                                    icon 'MaterialIcons.done'
                                                    size '15'
                                                    color '@c1'
                                                    padding '0 5 0 0'
                                                }
                                            }
                                        }
                                        TextView {
                                            name 'PasswordRules4'
                                            data {
                                                data 'Password must contain 1 special character.'
                                            }
                                        }
                                    ]
                                }
                                Row {
                                    name 'id'
                                    data {
                                        crossAxisAlignment 'center'
                                    }
                                    children [
                                        CIf {
                                            name 'id'
                                            condition `!isContainsSpace && this.newPassword != ''`
                                            then IconView {
                                                name 'Icon'
                                                data {
                                                    icon 'MaterialIcons.done'
                                                    size '15'
                                                    color '@c1'
                                                    padding '0 5 0 0'
                                                }
                                            }
                                        }
                                        TextView {
                                            name 'PasswordRules5'
                                            data {
                                                data 'Password should not contain any space.'
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                        LabelWithInputField {
                            name 'TextField'
                            data {
                                name 'Confirm Password'
                                value `confirmPassword`
                                placeHolder 'Enter Confirm Password'
                                obscureText 'true'
                            }
                            twoWayBinding true
                        }
                        CIf {
                            name 'id'
                            condition `showErrors`
                            then CFor {
                                name 'Error'
                                var 'error'
                                items `errorMessages`
                                type String
                                item TextView {
                                    name 'id'
                                    styles [
                                        ErrorLabel
                                    ]
                                    data {
                                        data `error`
                                    }
                                }
                            }
                        }
                        CIf {
                            name 'Validate5'
                            condition `isNotMatchedPassword`
                            then TextView {
                                name 'Text'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'Password and Confirm Password must match'
                                }
                            }
                        }
                        CIf {
                            name 'Validate'
                            condition `showValidationError`
                            then TextView {
                                name 'Text'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'Password does not meet pasword rules'
                                }
                            }
                        }
                        CIf {
                            name 'Password'
                            condition `showPasswordError`
                            then TextView {
                                name 'Text'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'Please enter new password and confirm password'
                                }
                            }
                        }
                        CIf {
                            name 'NewPassword'
                            condition `showNewPasswordError`
                            then TextView {
                                name 'Text'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'Please enter new password'
                                }
                            }
                        }
                        CIf {
                            name 'ConfirmPassword'
                            condition `showConfirmPasswordError`
                            then TextView {
                                name 'Text'
                                styles [
                                    ErrorLabel
                                ]
                                data {
                                    data 'Please enter  confirm password'
                                }
                            }
                        }
                        Button {
                            name 'DoneRB'
                            styles [
                                Primary
                            ]
                            data {
                                margin '10 0 0'
                            }
                            child Row {
                                name 'Row'
                                data {
                                    mainAxisAlignment 'center'
                                }
                                children [
                                    TextView {
                                        name 'id'
                                        data {
                                            data 'Submit'
                                        }
                                    }
                                ]
                            }
                        }
                        CIf {
                            name 'id'
                            condition `showSuccess`
                            then Row {
                                name 'id'
                                data {
                                    width '300'
                                }
                                children [
                                    TextView {
                                        name 'id'
                                        data {
                                            data 'Password updated successFully !'
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    }
    eventHandlers [
            {
            name 'onInit'
            block ```
                client = TwilioClient('');
                client.data = CallData(deviceReady: false);
                data = client.data;
            ```
        }
        {
            name 'OnPasswordSetHandler'
            type OnEvent
            on doneRB
            event onPressed
            block ```
                onChangeValidation();
            ```
        }
        {
            name 'NewPasswordSetHandler'
            type OnEvent
            on newPasswordFieldWithLabel
            event onChanged
            block ```
                isNotMinimumLengthPwd = false;
                this.newPassword = value;
            ```
        }
        {
            name 'ConfirmPasswordSetHandler'
            type OnEvent
            on textField
            event onChanged
            block ```
                isNotMatchedPassword = false;
                this.confirmPassword = value;
            ```
        }
        {
            name 'OnChangePassword'
            block ```
                this.showErrors = false;
                this.showPasswordError = false;
                this.showConfirmPasswordError = false;
                this.showSuccess = false;
                Result<ChangePasswordRequest> result = ChangePasswordRequest(
                    newPassword: this.newPassword,
                ).save().await;
                if (result.status == Success) {
                    this.showSuccess = true;
                    AuditLogUtils.loginedUser = user;
                    navigator.pushRoutePage(user: user);
                } else {
                    this.errorMessages = result.errors;
                    this.showErrors = true;
                    //this.showValidationError = true;
                }
            ```
        }
        {
            name 'OnChangeValidation'
            block ```
                if(this.newPassword.contains(' ')){
                    this.isContainsSpace=true;
                }else if(this.newPassword.isNotEmpty &&  this.confirmPassword.isNotEmpty && this.newPassword != this.confirmPassword) {
                    this.isNotMatchedPassword = true;
                }else if(this.newPassword.isNotEmpty && this.confirmPassword.length <=0){
                        this.showConfirmPasswordError = true;
                }else if(this.confirmPassword.isNotEmpty && this.newPassword.length <=0){
                        this.showNewPasswordError = true;
                }else if(this.newPassword.length <= 0 && this.confirmPassword.length <=0){
                        this.showPasswordError = true;
                }else if(!(isNumberMissing || isSpecialCharacterMissing || isUpperCaseMissing  || isLowerCaseMissing || isContainsSpace || isNotMinimumLengthPwd)){
                       onChangePassword();
                }else {
                    this.showValidationError = true;
                }
            ```
        }
        {
            name 'ConfirmPasswordErrorHandler'
            type OnEvent
            on textField
            event onTap
            block ```
                this.showSuccess = false;
                this.showValidationError = false;
                this.isNotMatchedPassword = false;
                this.showPasswordError = false;
                this.showConfirmPasswordError = false;
                this.showNewPasswordError = false;
            ```
        }
        {
            name 'PasswordErrorHandler'
            type OnEvent
            on newPasswordFieldWithLabel
            event onTap
            block ```
                this.showSuccess = false;
                this.showValidationError = false;
                this.showPasswordError = false;
                this.showConfirmPasswordError = false;
                this.showNewPasswordError = false;
            ```
        }
    ]
    title 'AdminChangePassWord'
}
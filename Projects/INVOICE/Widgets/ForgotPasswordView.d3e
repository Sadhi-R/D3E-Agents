Widget {
    package 'remote_canva.com'
    name 'Forgot Password View'
    category 'UserDefined'
    build Row {
        name 'Main Row'
        data {
            width '1200'
            height '700'
        }
        children [
            Column {
                name 'Column'
                data {
                    expand 'true'
                    decoration {
                        color '@c16'
                    }
                    mainAxisAlignment 'center'
                }
                children [
                    IconView {
                        name 'IconView'
                        data {
                            size '100'
                            icon 'MaterialIcons.password'
                            color '@c30'
                        }
                    }
                    TextView {
                        name 'Title Text View'
                        data {
                            data 'Forgot your Password ?'
                            color '@c1'
                            fontSize '30'
                            fontWeight 'w900'
                            softWrap 'true'
                            textAlign 'center'
                            width '400'
                        }
                    }
                    TextView {
                        name 'Title Text View'
                        data {
                            data 'We will help you recover it.'
                            color '@c1'
                            fontSize '30'
                            fontWeight 'w900'
                            softWrap 'true'
                            textAlign 'center'
                            width '400'
                        }
                    }
                    TextView {
                        name 'Description TextView'
                        data {
                            data 'Enter your registered email below to receive password reset instructions.'
                            color '@c1'
                            fontSize '20'
                            fontWeight 'w500'
                            textAlign 'center'
                            softWrap 'true'
                        }
                    }
                ]
            }
            Column {
                name 'Column2'
                data {
                    expand 'true'
                    mainAxisAlignment 'center'
                }
                children [
                    Column {
                        name 'Column3'
                        data {
                            width '400'
                            padding '40'
                            mainAxisAlignment 'center'
                            decoration {
                                color '@c1'
                                border {
                                    color '@c3'
                                    width '1.0'
                                }
                                boxShadow {
                                    color 'ff333333'
                                    offset {
                                        dx '1'
                                        dy '1'
                                    }
                                }
                            }
                        }
                        children [
                            TextView {
                                name 'TextView'
                                data {
                                    data 'Reset Password'
                                    fontSize '30'
                                    fontWeight 'w800'
                                    softWrap 'true'
                                }
                            }
                            LabelWithInputField {
                                name 'Email Field'
                                data {
                                    isRequired 'true'
                                    width '400'
                                    label 'Email Field'
                                    obscureText 'false'
                                    placeHolder 'Enter your Email Field'
                                    margin '1 1 20'
                                }
                            }
                            Button {
                                name 'Reset Button'
                                data {
                                    decoration {
                                        color '@c15'
                                    }
                                    padding '10'
                                }
                                child TextView {
                                    name 'ButtonText'
                                    data {
                                        data 'Send Reset Link'
                                        color '@c1'
                                    }
                                }
                            }
                            Row {
                                name 'Row'
                                data {
                                    mainAxisAlignment 'center'
                                    margin '15 1 1 1'
                                }
                                children [
                                    TextView {
                                        name 'TextView2'
                                        data {
                                            data 'Back to Sign In'
                                        }
                                    }
                                    TextView {
                                        name 'TextView3'
                                        data {
                                            data 'Click Here'
                                            fontWeight 'w700'
                                            textDecoration 'underline'
                                            decorationColor '@c14'
                                            cursor 'click'
                                        }
                                        behaviours [
                                            GestureDetector
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
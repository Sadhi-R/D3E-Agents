(Model Customer) {
    name 'Customer'
    properties [
        {
            name 'Name'
            type String
            required true
        }
        {
            name 'Email'
            type String
            required true
            unique true
        }
        {
            name 'Phone'
            type String
            required true
            unique true
        }
        {
            name 'Address Line 1'
            type String
            required true
        }
        {
            name 'Address Line 2'
            type String
        }
        {
            name 'City'
            type String
            required true
        }
        {
            name 'State'
            type String
            required true
        }
        {
            name 'Postal Code'
            type String
            required true
        }
        {
            name 'Country'
            type String
            required true
        }
        {
            name 'Full Address'
            type String
            computed true
            computation `addressLine1 + (addressLine2.isEmpty ? '' : ', ' + addressLine2) + ', ' + city + ', ' + state + ' ' + postalCode + ', ' + country`
        }
    ]
    needCreatedDate true
    needUpdatedDate true
}
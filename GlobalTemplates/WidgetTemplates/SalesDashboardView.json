{
  "name": "SalesDashboardView",
  "properties": [
    { "name": "salesData", "type": "Sale","collection": "true", "required": true },
    { "name": "timeRange", "type": "String", "internal": true },
    { "name": "selectedMetric", "type": "String", "internal": true }
  ],
  "components": [
    "ChartView",
    "MetricsCard",
    "LabelDropdown",
    "DateRangePicker"
  ],
  "slots": [
    { "name": "customMetrics" },
    { "name": "filterOptions" }
  ],
  "events": [
    { "name": "onMetricChanged", "params": ["String"] },
    { "name": "onTimeRangeChanged", "params": ["String"] }
  ],
  "eventHandlers": [
    { "name": "onInit" },
    { "name": "onRangeSelected", "on": "DateRangePicker", "event": "onRangeChanged" },
    { "name": "onMetricSelect", "on": "LabelDropdown", "event": "onSelectionChanged" }
  ]
}

{
  "name": "EditProfileView",
  "properties": [
    { "name": "user", "type": "User", "required": true },
    { "name": "isEditing", "type": "Boolean", "internal": true },
    { "name": "isSaving", "type": "Boolean", "internal": true }
  ],
  "components": [
    "LabelWithInputField",
    "Button",
    "Loader",
    "ImagePicker"
  ],
  "slots": [
    { "name": "additionalFields" }
  ],
  "events": [
    { "name": "onProfileSaved", "params": ["User"] },
    { "name": "onCancel" }
  ],
  "eventHandlers": [
    { "name": "onInit" },
    { "name": "onSave", "on": "SaveButton", "event": "onPressed" },
    { "name": "onCancelEdit", "on": "CancelButton", "event": "onPressed" }
  ]
}

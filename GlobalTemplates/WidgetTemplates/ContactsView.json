{
  "name": "ContactsView",
  "properties": [
    { "name": "contacts", "type": "List<User>", "required": true },
    { "name": "searchText", "type": "String", "internal": true },
    { "name": "selectedContact", "type": "User", "internal": true }
  ],
  "components": [
    "SearchComponent",
    "ListView",
    "ContactCard",
    "ContactDetailsView"
  ],
  "slots": [
    { "name": "contactActions" }
  ],
  "events": [
    { "name": "onContactSelected", "params": ["User"] }
  ],
  "eventHandlers": [
    { "name": "onInit" },
    { "name": "onSearch", "on": "SearchComponent", "event": "onSearchChanged" },
    { "name": "onContactTap", "on": "ContactCard", "event": "onTap" }
  ]
}
